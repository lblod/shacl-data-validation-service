@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:DocumentShape a sh:NodeShape ;
  sh:targetClass ex:Document ;
  sh:property ex:hasTitle .

ex:ReportShape a sh:NodeShape ;
  sh:targetClass ex:Report ;
  sh:property ex:hasTitle .

ex:hasTitle a sh:PropertyShape ;
  sh:path ex:title ;
  sh:minCount 1 .

ex:SessionShape a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX ex: <http://example.org/>
      SELECT ?this WHERE { ?this ex:heldBy ex:council . }"""
  ] ;
  sh:property [
    sh:path ex:hasDocument ;
    sh:minCount 1
  ] .
