@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:DocumentShape a sh:NodeShape ;
  sh:property ex:hasTitle .

ex:ReportShape a sh:NodeShape ;
  sh:property ex:hasTitle .

ex:hasTitle a sh:PropertyShape ;
  sh:path ex:title ;
  sh:minCount 1 .

ex:SessionShape a sh:NodeShape ;
  sh:property [
    sh:path ex:hasDocument ;
    sh:minCount 1
  ] .

ex:AuditedTitleShape a sh:NodeShape ;
  sh:property ex:hasTitle .

ex:AuditedAuthorShape a sh:NodeShape ;
  sh:property [
    sh:path ex:author ;
    sh:minCount 1 ;
  ] .
