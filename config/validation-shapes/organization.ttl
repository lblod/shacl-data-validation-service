@prefix ext: <http://mu.semte.ch/vocabularies/ext/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix regorg: <http://www.w3.org/ns/regorg#> .
@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ere: <http://data.lblod.info/vocabularies/erediensten/> .
@prefix code: <http://lblod.data.gift/vocabularies/organisatie/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ext:prefixes sh:declare [
    a sh:PrefixDeclaration ;
    sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI ;
    sh:prefix "org" ;
    ] .

ext:organizationShape a sh:NodeShape ;
  sh:targetClass org:Organization ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:datatype xsd:string ;
    sh:minCount 1
    ] ;
  sh:property [
    sh:path org:classification ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  sh:property [
    sh:path regorg:orgStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  # TODO: using SPARQL-SHACL causes a type error in the comunica query engine
  # dependency of shacl-engine.  Not sure whether I am doing some wrong or
  # whether this is a bug.
  # sh:property [
  #   sh:path org:classification ;
  #   sh:sparql [
  #     a sh:SPARQLConstraint ;
  #     sh:prefixes ext:prefixes ;
  #     sh:select """SELECT $this ?value
  #       WHERE {
  #         $this $PATH ?value .
  #         FILTER (!isIRI(?value))
  #       }""" ;
  #     ]
  #   ]
  .

# Fake validation that an organisation must have an alternative label.
ext:organizationWithAltNameShape a sh:NodeShape ;
  sh:targetClass org:Organization ;
  sh:property [
    sh:path skos:altLabel ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    ] .

# TODO: This does not seem to work correctly
# Fake validation shape that an AVZ may not be an administrative unit
ext:organisationNotAdministrativeUnit a sh:NodeShape ;
  sh:targetClass org:Organization ;
  sh:not [
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:class besluit:Bestuurseenheid ;
    ] .

ext:worshipOrganisationHasMinisterPosition a sh:NodeShape ;
  sh:targetClass ere:BestuurVanDeEredienst ;
  sh:property [
    sh:path ere:wordtBediendDoor ;
    sh:node ext:PositieBedienaar ;
    sh:minCount 1 ;
    ] .

ext:PositieBedienaar a sh:NodeShape ;
  sh:targetClass ere:PositieBedienaar ;
  sh:property [
    sh:path ere:functie ;
    sh:name "functie" ;
    sh:description "Het beroep van de bedienaar, bv. pastoor, imam" ;
    sh:node ext:EredienstBeroep
    ] .
ext:EredienstBeroep a sh:NodeShape ;
  rdfs:label "beroep" ;
  sh:targetClass code:EredienstBeroepen ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:name "naam" ;
    sh:datatype xsd:string
    ] ;
  sh:property [
    sh:path ere:vanToepassingBijStatus ;
    sh:name "van toepassing bij status" ;
    sh:description "De organisatiestatussen waarbij dit beroep voorkomt" ;
    sh:node ext:OrganisatieStatus
    ] .

ext:OrganisatieStatus a sh:NodeShape ;
  rdfs:label "organisatiestatus" ;
  sh:targetClass code:OrganisatieStatusCode ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:name "naam" ;
    sh:datatype xsd:string
    ] .
