@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Paths
ex:PredicateShape sh:property [ sh:path ex:label ] .

ex:InverseShape sh:property [ sh:path [ sh:inversePath ex:next ] ] .

ex:SequenceShape sh:property [ sh:path ( ex:next ex:part ) ] .

ex:AlternativeShape sh:property [ sh:path [ sh:alternativePath ( ex:label ex:title ) ] ] .

ex:ZeroOrMoreShape sh:property [ sh:path [ sh:zeroOrMorePath ex:next ] ] .

ex:OneOrMoreShape sh:property [ sh:path [ sh:oneOrMorePath ex:next ] ] .

ex:ZeroOrOneShape sh:property [ sh:path [ sh:zeroOrOnePath ex:next ] ] .

# Nested shapes
ex:NodeShape sh:property [ sh:path ex:next ; sh:node ex:WithPart ] .

ex:WithPart sh:property [ sh:path ex:part ] .

ex:OrShape sh:or ( [ sh:property [ sh:path ex:label ] ] [ sh:property [ sh:path ex:title ] ] ) .

ex:AndShape sh:and ( [ sh:property [ sh:path ex:label ] ] [ sh:property [ sh:path ex:title ] ] ) .

ex:NotShape sh:not [ sh:property [ sh:path ex:label ] ] .

ex:DeactivatedNestedShape sh:property [ sh:path ex:next ; sh:node ex:DeactivatedPart ] .

ex:DeactivatedPart sh:deactivated true ;
  sh:property [ sh:path ex:part ] .

# Other constraints that need data
ex:ClassShape sh:property [ sh:path ex:owner ; sh:class ex:Person ] .

ex:ClosedShape sh:closed true .

ex:PairShape sh:property [ sh:path ex:label ; sh:equals ex:title ] .

# Targets, which the CONSTRUCT query doesn't use
ex:LabelledClassTargetShape sh:targetClass ex:Typed ;
  sh:property [ sh:path ex:label ] .
