@prefix ext: <http://mu.semte.ch/vocabularies/ext/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix regorg: <http://www.w3.org/ns/regorg#> .
@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ext:prefixes sh:declare [
    a sh:PrefixDeclaration ;
    sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI ;
    sh:prefix "org" ;
    ] .

ext:organizationShape a sh:NodeShape ;
  sh:targetClass org:Organization ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:datatype xsd:string ;
    sh:minCount 1
    ] ;
  sh:property [
    sh:path org:classification ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  sh:property [
    sh:path regorg:orgStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  # TODO: using SPARQL-SHACL causes a type error in the comunica query engine
  # dependency of shacl-engine.  Not sure whether I am doing some wrong or
  # whether this is a bug.
  # sh:property [
  #   sh:path org:classification ;
  #   sh:sparql [
  #     a sh:SPARQLConstraint ;
  #     sh:prefixes ext:prefixes ;
  #     sh:select """SELECT $this ?value
  #       WHERE {
  #         $this $PATH ?value .
  #         FILTER (!isIRI(?value))
  #       }""" ;
  #     ]
  #   ]
  .

# Fake validation that an active organisation or an AGB must have an alternative
# label.
ext:organizationWithAltNameShape a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX org: <http://www.w3.org/ns/org#>
      PREFIX regorg: <http://www.w3.org/ns/regorg#>
      SELECT DISTINCT ?this WHERE {
        ?this a org:Organization .
        {
          ?this regorg:orgStatus <http://lblod.data.gift/concepts/63cc561de9188d64ba5840a42ae8f0d6> .
        } UNION {
          ?this org:classification <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/36a82ba0-7ff1-4697-a9dd-2e94df73b721> .
        }
      }"""
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    ] .

# TODO: This does not seem to work correctly
# Fake validation shape that an AVZ may not be an administrative unit
ext:organisationNotAdministrativeUnit a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX org: <http://www.w3.org/ns/org#>
      SELECT DISTINCT ?this WHERE {
        ?this a org:Organization ;
          org:classification <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/34b5af85-dc9f-468f-9e03-ef89b174c267> .
      }"""
  ] ;
  sh:not [
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:class besluit:Bestuurseenheid ;
    ] .
