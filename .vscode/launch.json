{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to shacl-data-validation (Docker)",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/usr/src/dist",
      "sourceMaps": true,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
