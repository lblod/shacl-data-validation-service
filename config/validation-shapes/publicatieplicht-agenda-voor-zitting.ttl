@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pp: <http://data.lblod.info/shapes/publicatieplicht#> .

pp:AgendaVoorZitting a sh:NodeShape ;
  sh:name "Agenda gepubliceerd voor de zitting"@nl ;
  sh:description "Een zitting van de gemeenteraad en de raad voor maatschappelijk welzijn heeft een agenda, die gepubliceerd wordt voor de dag van de zitting."@nl ;
  dct:source <https://www.vlaanderen.be/lokaal-bestuur/organisatie-en-werking/publicatieplicht/publicatieplichtige-documenten> ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
      PREFIX mandaat: <http://data.vlaanderen.be/ns/mandaat#>
      PREFIX org: <http://www.w3.org/ns/org#>
      SELECT DISTINCT ?this WHERE {
        VALUES ?classificatie {
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000005>
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000007>
        }
        ?this a besluit:Zitting ;
          besluit:isGehoudenDoor/mandaat:isTijdspecialisatieVan?/(besluit:classificatie|org:classification) ?classificatie .
      }"""
  ] ;
  sh:property pp:AgendaVoorZitting-gepubliceerd ;
  sh:rule pp:AgendaVoorZitting-bronZonderFragment .

# The harvester pipeline links the data it harvests with the URI of the page it harvested it from
# (prov:wasDerivedFrom), which doesn't always match the URI the publisher links the agenda with, e.g. Zottegem
# links GetPublication/?filename=Agenda.html#Agenda3030 while its agendapunten are derived from
# GetPublication?filename=Agenda.html. Data derived from the linked URI without fragment, with or without a '/'
# before the '?', counts as derived from the linked agenda. The service runs this rule on the store, with $this
# bound to the session, and adds the triples it constructs to the data graph before validation.
pp:AgendaVoorZitting-bronZonderFragment a sh:SPARQLRule ;
  sh:construct """
    PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    CONSTRUCT {
      ?entity prov:wasDerivedFrom ?agenda .
    } WHERE {
      $this besluit:heeftAgenda ?agenda .
      FILTER(isIRI(?agenda))
      BIND(REPLACE(REPLACE(STR(?agenda), "#.*$", ""), "/[?]", "?") AS ?withoutSlash)
      VALUES ?slash { "" "/" }
      BIND(IRI(REPLACE(?withoutSlash, "[?]", CONCAT(?slash, "?"))) AS ?source)
      ?entity prov:wasDerivedFrom ?source .
    }""" .

# The session links its agenda (besluit:heeftAgenda), and the agenda is published: data is derived from it
# (prov:wasDerivedFrom). A link to a document without linked data, e.g. a PDF, isn't enough.
pp:AgendaVoorZitting-gepubliceerd a sh:PropertyShape ;
  sh:path besluit:heeftAgenda ;
  sh:qualifiedValueShape [
    sh:property [
      sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
      sh:minCount 1
    ]
  ] ;
  sh:qualifiedMinCount 1 ;
  sh:severity sh:Violation ;
  sh:message "Er is geen agenda gepubliceerd voor deze zitting: geen enkel document gekoppeld met besluit:heeftAgenda is de bron van gegevens (prov:wasDerivedFrom)."@nl .