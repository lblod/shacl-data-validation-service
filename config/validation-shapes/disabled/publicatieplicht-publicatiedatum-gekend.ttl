@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix pp: <http://data.lblod.info/shapes/publicatieplicht#> .

# The publication date is taken from the published document itself (eli:date_publication of its foaf:Document).
pp:PublicatiedatumGekend a sh:NodeShape ;
  sh:name "Publicatiedatum gekend"@nl ;
  sh:description "Een publicatieplichtig document vermeldt zijn publicatiedatum, zodat de tijdigheid gecontroleerd kan worden."@nl ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
      PREFIX mandaat: <http://data.vlaanderen.be/ns/mandaat#>
      PREFIX org: <http://www.w3.org/ns/org#>
      SELECT DISTINCT ?this WHERE {
        VALUES ?classificatie {
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000005>
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000006>
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/4955bd72cd0e4eb895fdbfab08da0284>
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000007>
          <http://data.vlaanderen.be/id/concept/BestuursorgaanClassificatieCode/5ab0e9b8a3b2ca7c5e000008>
        }
        ?zitting a besluit:Zitting ;
          besluit:isGehoudenDoor/mandaat:isTijdspecialisatieVan?/(besluit:classificatie|org:classification) ?classificatie ;
          besluit:heeftAgenda|besluit:heeftBesluitenlijst|besluit:heeftNotulen ?this .
      }"""
  ] ;
  sh:property pp:PublicatiedatumGekend-aanwezig .

pp:PublicatiedatumGekend-aanwezig a sh:PropertyShape ;
  sh:path eli:date_publication ;
  sh:minCount 1 ;
  sh:severity sh:Info ;
  sh:message "De publicatiedatum (eli:date_publication) van dit document is onbekend, de tijdigheid kan niet gecontroleerd worden."@nl .
