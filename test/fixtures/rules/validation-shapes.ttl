@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:AltLabelShape a sh:NodeShape ;
  sh:property [
    sh:path ex:altLabel ;
    sh:minCount 1 ;
  ] .

ex:StatusShape a sh:NodeShape ;
  sh:property [
    sh:path ex:status ;
    sh:minCount 1 ;
  ] .

ex:LocalShape a sh:NodeShape ;
  sh:property [
    sh:path ex:classification ;
    sh:maxCount 1 ;
  ] .

ex:TargetedShape a sh:NodeShape ;
  sh:targetClass ex:Organization .
